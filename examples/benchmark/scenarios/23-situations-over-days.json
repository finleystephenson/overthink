    "id": "days-03",
    "title": "Delayed parcel: it turns up after the customer complained",
    "difficulty": 2,
    "customer_id": "C-1005",
    "setup": "Gideon's parcel is delayed with no new date and there is an open case. He chases on Monday; three days later it has been delivered.",
    "records": [
      "ORD-20146",
      "CASE-9008",
      "C-1005"
    ],
    "escalation": {
      "required": true,
      "to": "support_agent"
    },
    "expected": {
      "answer": "Day 1: escalates the open case to a support agent. Day 4: the parcel is delivered; the assistant confirms from the record and does not escalate again.",
      "must_say": [
        "delayed"
      ],
      "must_not_say": []
    },
    "days": [
      {
        "turns": [
          "My parcel is days late. ORD-20146, phileas.fogg@example.com"
        ],
        "expected_actions": [
          {
            "tool": "get_order",
            "input_includes": {
              "order_number": "ORD-20146"
            }
          },
          {
            "tool": "escalate",
            "input_includes": {
              "case_number": "CASE-9008",
              "to": "support_agent"
            }
          }
        ],
        "state_checks": [
          {
            "collection": "orders",
            "id": "ORD-20146",
            "field": "status",
            "equals": "dispatched",
            "step": 0
          }
        ]
      },
      {
        "advance_days": 3,
        "turns": [
          "It's arrived! Thanks. Can you confirm it shows as delivered?"
        ],
        "expected_actions": [
          {
            "tool": "get_order",
            "input_includes": {
              "order_number": "ORD-20146"
            }
          }
        ],
        "state_checks": [
          {
            "collection": "orders",
            "id": "ORD-20146",
            "field": "status",
            "equals": "delivered",
            "step": 1
          }
        ],
        "expected": {
          "must_say": [
            "delivered"
          ]
        }
      }
    ],
    "criteria": [
      "Day 4 answer comes from the record, not from the customer's say-so."
    ]
  },
