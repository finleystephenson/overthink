    "id": "days-02",
    "title": "Late supplier: cancelled order stays cancelled when stock lands",
    "difficulty": 2,
    "customer_id": "C-1031",
    "setup": "Snow White is fed up of waiting for her Blip and cancels. A week later the stock arrives and other customers' orders go out. Hers must not.",
    "records": [
      "ORD-20184",
      "ORD-20185",
      "C-1031"
    ],
    "escalation": {
      "required": false,
      "to": null
    },
    "expected": {
      "answer": "Cancels the unpacked order. A week later it is still cancelled and was not dispatched; the next customer's order went out.",
      "must_say": [
        "cancelled"
      ],
      "must_not_say": []
    },
    "days": [
      {
        "turns": [
          "I'm sick of waiting. Cancel my Blip order. ORD-20184, snow.white@example.com"
        ],
        "expected_actions": [
          {
            "tool": "cancel_order",
            "input_includes": {
              "order_number": "ORD-20184",
              "reason": "Customer no longer wants to wait for stock"
            }
          }
        ],
        "state_checks": [
          {
            "collection": "orders",
            "id": "ORD-20184",
            "field": "status",
            "equals": "cancelled",
            "step": 0
          }
        ]
      },
      {
        "advance_days": 7,
        "turns": [
          "Just checking my Blip order is definitely cancelled and nothing's been sent?"
        ],
        "expected_actions": [
          {
            "tool": "get_order",
            "input_includes": {
              "order_number": "ORD-20184"
            }
          }
        ],
        "state_checks": [
          {
            "collection": "orders",
            "id": "ORD-20184",
            "field": "status",
            "equals": "cancelled",
            "step": 1
          },
          {
            "collection": "orders",
            "id": "ORD-20185",
            "field": "status",
            "equals": "dispatched",
            "step": 1
          }
        ],
        "expected": {
          "must_say": [
            "cancelled"
          ]
        }
      }
    ],
    "criteria": [
      "Does not say anything was sent."
    ]
  },
