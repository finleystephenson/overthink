    "id": "days-01",
    "title": "Late supplier: the customer chases, then the stock arrives",
    "difficulty": 2,
    "customer_id": "C-1017",
    "setup": "Becky's paid Blip order is waiting on a late supplier. She asks on Monday, then again a week later after the stock has come in.",
    "records": [
      "ORD-20183",
      "C-1017"
    ],
    "escalation": {
      "required": false,
      "to": null
    },
    "expected": {
      "answer": "Day 1: tells her the Blip is waiting on stock and gives no firm date. Day 8: the order is dispatched and the assistant says so.",
      "must_say": [],
      "must_not_say": [
        "guaranteed"
      ]
    },
    "days": [
      {
        "turns": [
          "Where is my Blip? ORD-20183, becky.sharp@example.com"
        ],
        "expected_actions": [
          {
            "tool": "get_order",
            "input_includes": {
              "order_number": "ORD-20183"
            }
          }
        ],
        "state_checks": [
          {
            "collection": "orders",
            "id": "ORD-20183",
            "field": "status",
            "equals": "paid",
            "step": 0
          }
        ],
        "expected": {
          "must_say": [
            "stock"
          ]
        }
      },
      {
        "advance_days": 7,
        "turns": [
          "Any news on the Blip now? Same order."
        ],
        "expected_actions": [
          {
            "tool": "get_order",
            "input_includes": {
              "order_number": "ORD-20183"
            }
          }
        ],
        "state_checks": [
          {
            "collection": "orders",
            "id": "ORD-20183",
            "field": "status",
            "equals": "dispatched",
            "step": 1
          }
        ],
        "expected": {
          "must_say": [
            "dispatched"
          ]
        }
      }
    ],
    "criteria": [
      "On day 8 it looks the order up again rather than repeating what it said on day 1."
    ]
  },
