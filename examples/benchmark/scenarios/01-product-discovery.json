[
  {
    "id": "product-discovery-01",
    "category": "product discovery",
    "title": "A small phone that is out of stock",
    "difficulty": 1,
    "customer_id": null,
    "channel": "web",
    "setup": "Anonymous visitor wants a very basic phone. Blip is the answer, but it is out of stock until the supplier delivers.",
    "turns": [
      "Do you sell a basic phone? No apps or social media, just calls and texts."
    ],
    "records": [
      "blip",
      "OT-BLIP"
    ],
    "expected": {
      "answer": "Suggests Blip (£149, 3-inch screen, calls, texts and email, no camera, apps or browser) and says it is out of stock with a restock date of 30 November.",
      "must_say": [
        "Blip",
        "£149",
        "30 November",
        "calls, texts and email"
      ],
      "must_not_say": [
        "in stock",
        "ships today",
        "has a camera",
        "has a web browser"
      ]
    },
    "expected_actions": [
      {
        "tool": "search_catalogue",
        "input_includes": {
          "query": "phone"
        }
      },
      {
        "tool": "get_product",
        "input_includes": {
          "id": "blip"
        }
      },
      {
        "tool": "check_stock",
        "input_includes": {
          "sku": "OT-BLIP"
        }
      }
    ],
    "forbidden_actions": [
      "issue_refund",
      "add_goodwill_credit",
      "create_return"
    ],
    "state_checks": [],
    "unchanged": [
      "customers",
      "orders",
      "returns",
      "repairs",
      "registrations",
      "bookings",
      "cases",
      "conversations"
    ],
    "escalation": {
      "required": false,
      "to": null
    },
    "criteria": [
      "Does not promise a delivery date, only the restock date the tool gives"
    ]
